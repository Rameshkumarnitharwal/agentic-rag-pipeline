# Jina AI — embeddings (jina-embeddings-v3) + reranker
JINA_API_KEY=

# Qdrant Cloud (or set QDRANT_PATH=./qdrant_local for embedded local mode)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_rag

# Local mxbai-embed-large-v1 fallback (downloads ~670 MB on first use)
LOCAL_EMBEDDINGS_ENABLED=true

# Retrieval tuning
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
RERANK_MIN_SCORE=0.2

# Portkey LLM gateway (OpenAI only).
# Add your OpenAI API key in Portkey's Model Catalog as a provider (e.g. named "openai");
# the OpenAI key itself lives in Portkey, not in this file.
PORTKEY_API_KEY=
# Models in fallback order: "@<your-provider-slug>/<model>"
LLM_MODELS=@openai/gpt-4o,@openai/gpt-4o-mini
# Saved Portkey config id (pc-...). Required if your workspace blocks inline configs;
# when set, it decides routing/fallback instead of LLM_MODELS.
PORTKEY_CONFIG_ID=
# Fast tier for guardrail checks and planning (called directly; falls back to the main route)
LLM_FAST_MODEL=@openai/gpt-4o-mini
LLM_FALLBACK_ON_STATUS_CODES=429,500,502,503,504
LLM_RETRY_ATTEMPTS=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# USD per 1M tokens [input, output], longest model-name prefix wins (for cost-per-query tracking)
LLM_PRICES={"gpt-4o": [2.5, 10], "gpt-4o-mini": [0.15, 0.6]}

# NeMo Guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_OUTPUT_ENABLED=true
GUARDRAILS_FAIL_OPEN=false
GUARDRAILS_MAX_INPUT_CHARS=4000
# GUARDRAILS_ALLOWED_TOPICS="Kubernetes workloads ... and Databricks job automation ..."

# Agent (LangGraph)
AGENT_PARALLEL_PLANNING=true
AGENT_MAX_ITERATIONS=2
AGENT_MAX_SEARCH_QUERIES=3
AGENT_MAX_CONTEXT_CHUNKS=6
AGENT_HISTORY_TURNS=6

# API security
# comma-separated bearer tokens; empty = no auth (dev only)
API_KEYS=
# per API key / client IP; 0 disables
RATE_LIMIT_PER_MINUTE=30
# e.g. redis://localhost:6379/0 — shared limiter across workers
REDIS_URL=

# Streamlit UI (ui/app.py)
RAG_API_URL=http://localhost:8000
# one of API_KEYS, if auth is enabled
RAG_API_KEY=

# Evaluation (RAGAS judge via Portkey -> OpenAI)
EVAL_JUDGE_MODEL=@openai/gpt-4o-mini
EVAL_EMBEDDING_MODEL=@openai/text-embedding-3-small
EVAL_CONCURRENCY=4
EVAL_JUDGE_MAX_TOKENS=4096

# Tracing — Pydantic Logfire (on when a write token is set)
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development
# true = print spans to the terminal (local debugging, no token needed)
LOGFIRE_CONSOLE=false

# Tracing — LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-rag
